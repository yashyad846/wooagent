# ---------------------------------------------------------------------------
# Which store to read. No trailing slash.
# The fixture store (`npm run fixture`) listens here.
# ---------------------------------------------------------------------------
WC_STORE_URL=http://localhost:4455

# ---------------------------------------------------------------------------
# How to authenticate. Two ways:
#   a) paste a read-only key:  WooCommerce > Settings > Advanced > REST API
#   b) delete the two lines below and run `npm run link` for the approval flow
# The values here are the fixture store's built-in key -- useless anywhere else.
# ---------------------------------------------------------------------------
WC_CONSUMER_KEY=ck_fixture_8d41b0c2a97e5f36104b7e2d
WC_CONSUMER_SECRET=cs_fixture_52a9f7e01c6b4d83ea5f90b7

# Where the credential rides: auto | header (Basic, needs TLS) | query (OAuth 1.0a)
WC_SIGNING=auto

# ---------------------------------------------------------------------------
# Pacing. These protect the merchant's store from an over-eager agent.
# ---------------------------------------------------------------------------
WC_RPS=5
WC_BURST=10
WC_CONCURRENCY=4
WC_RETRIES=4
WC_TIMEOUT_MS=15000

# Buyer emails, phone numbers and street addresses are veiled unless this is true.
WC_SHOW_CONTACTS=false

# Where an approved key is stored. Written 0600.
# WC_KEY_FILE=.store-key.json
