{
  "name": "wc-storefront-reader",
  "version": "0.4.0",
  "description": "Read-only MCP connector that lets an agent answer questions about a WooCommerce store's orders and stock",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "wc-storefront-reader": "dist/src/main.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "dev": "tsx src/main.ts",
    "link-store": "tsx src/link.ts",
    "fixture": "tsx fixture/store.ts",
    "demo": "tsx scripts/demo.ts",
    "spec": "tsx scripts/tool-spec.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
